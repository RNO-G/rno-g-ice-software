[Unit]
Description=Apply SWEEP calibration overrides

# For now this timer is independent of the DAQ service.
# PartOf makes stop/restart of the target propagate here
# (Wants= in the target only propagates start).
PartOf=rno-g-apply-calib.target

[Timer]
# OnActiveSec: first firing, relative to the timer being started
# OnUnitActiveSec: later firings, relative to the last firing(!)
OnActiveSec=6h
OnUnitActiveSec=4w
