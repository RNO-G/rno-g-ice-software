{
  "_note": "Blocks are merged top to bottom; a later block wins. A 'stations'/'flavors' list scopes a block, an absent one matches all. Entries under 'stations' must be keyed by flavor (or 'ALL'). Keys starting with '_' are comments.",
  "station_source": "/STATION_ID",
  "flavors": ["DEEP", "SURF", "SWEEP"],
  "defaults_all": {
    "calib": {
      "enable_cal": 1,
      "channel": "fiber0",
      "type": "pulser",
      "atten": 0.0
    },
    "output": { "seconds_per_run": 120 }
  },
  "defaults_surf": {
    "_note": "Surface pulsing via coax: no attenuation, regardless of station.",
    "flavors": ["SURF"],
    "calib": {
      "channel": "coax",
      "atten": 0
    },
    "output": { "seconds_per_run": 300 }
  },
  "defaults_sweep": {
    "_note": "The run ends with the sweep; seconds_per_run must not cut it short.",
    "flavors": ["SWEEP"],
    "calib": { "sweep": { "enable": 1 } },
    "output": { "seconds_per_run": 10000 }
  },
  "defaults_didaq_deep": {
    "_note": "The coincidence triggers fire on the deep calpulser and prevent phased-array trigger, so switch them off.",
    "stations": [15, 25, 34, 35],
    "flavors": ["DEEP", "SWEEP"],
    "didaq": {
      "trigger": {
        "coinc0": { "enable": 0 },
        "coinc1": { "enable": 0 }
      }
    },
    "calib": { "atten": 10 }
  },
  "defaults_radiant_deep_more_atten": {
    "_note": "Other stations use default of 0.",
    "flavors": ["DEEP"],
    "stations": [12, 13, 14, 23],
    "calib": { "atten": 5 }
  },
  "stations": {
    "_note": "First RADIANT (legacy) stations, than DiDAQ stations.",
    "11": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 25, "stop_atten": 0 } } }
    },
    "12": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 30, "stop_atten": 8 } } }
    },
    "8": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 27, "stop_atten": 8 } } }
    },
    "14": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 27, "stop_atten": 8 } } }
    },
    "21": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 31, "stop_atten": 12 } } }
    },
    "22": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 22, "stop_atten": 3 } } }
    },
    "23": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 30, "stop_atten": 10 } } }
    },
    "24": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 27, "stop_atten": 6 } } }
    },
    "_note2": "DiDAQ stations. Other stations used default from 'defaults_didaq_deep' of 10.",
    "15": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 26, "stop_atten": 10 } } }
    },
    "25": {
      "DEEP": { "calib": { "atten": 15 } },
      "SWEEP": { "calib": { "sweep": { "start_atten": 31.5, "stop_atten": 11 } } }
    },
    "34": {
      "DEEP": { "calib": { "atten": 15 } },
      "SWEEP": { "calib": { "sweep": { "start_atten": 31, "stop_atten": 15 } } }
    },
    "35": {
      "SWEEP": { "calib": { "sweep": { "start_atten": 30, "stop_atten": 13 } } }
    }
  }
}
